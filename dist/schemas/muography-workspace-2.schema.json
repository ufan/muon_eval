{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "muography-workspace-2.schema.json",
  "title": "muography-workspace 2.x",
  "description": "Saved workspace of one dataset release, or an exported selection of it (docs/specs/WORKSPACE_FORMAT.md, proposed in ADR-033). Cross-item rules (unique IDs, references, selection closure, scenarios of the release) are checked by workspace-format.js.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "contents",
    "roots",
    "release",
    "units",
    "provenance",
    "detectors",
    "sites",
    "stations",
    "deployments",
    "studies"
  ],
  "properties": {
    "format": {
      "const": "muography-workspace"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^2\\.0\\.[0-9]+$"
    },
    "contents": {
      "enum": [
        "workspace",
        "selection"
      ]
    },
    "roots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(sta|dep|study)-[0-9a-hjkmnp-tv-z]{16}$"
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contentHash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "contentHash": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        }
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length",
        "angle"
      ],
      "properties": {
        "length": {
          "const": "m"
        },
        "angle": {
          "const": "deg"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app",
        "exportedAt",
        "author",
        "workspace"
      ],
      "properties": {
        "app": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "exportedAt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
            }
          ]
        },
        "author": {
          "type": "string",
          "maxLength": 100
        },
        "workspace": {
          "type": "string",
          "pattern": "^ws-[0-9a-hjkmnp-tv-z]{16}$"
        }
      }
    },
    "detectors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/detector"
      }
    },
    "sites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/site"
      }
    },
    "stations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/station"
      }
    },
    "deployments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deployment"
      }
    },
    "studies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/study"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contents": {
            "const": "workspace"
          }
        }
      },
      "then": {
        "properties": {
          "roots": {
            "maxItems": 0
          },
          "detectors": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contents": {
            "const": "selection"
          }
        }
      },
      "then": {
        "properties": {
          "roots": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "itemId": {
      "type": "string",
      "pattern": "^(det|site|sta|dep|study)-[0-9a-hjkmnp-tv-z]{16}$"
    },
    "detectorId": {
      "type": "string",
      "pattern": "^det-[0-9a-hjkmnp-tv-z]{16}$"
    },
    "siteId": {
      "type": "string",
      "pattern": "^site-[0-9a-hjkmnp-tv-z]{16}$"
    },
    "stationId": {
      "type": "string",
      "pattern": "^sta-[0-9a-hjkmnp-tv-z]{16}$"
    },
    "deploymentId": {
      "type": "string",
      "pattern": "^dep-[0-9a-hjkmnp-tv-z]{16}$"
    },
    "studyId": {
      "type": "string",
      "pattern": "^study-[0-9a-hjkmnp-tv-z]{16}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "note": {
      "type": "string",
      "maxLength": 1000
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "device",
        "response"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/detectorId"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "layers",
            "width",
            "height",
            "stripPitch",
            "strips",
            "spacing"
          ],
          "properties": {
            "model": {
              "type": "string",
              "maxLength": 100
            },
            "layers": {
              "const": 3
            },
            "width": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 5
            },
            "height": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 5
            },
            "stripPitch": {
              "type": "number",
              "minimum": 5e-05,
              "maximum": 0.1
            },
            "strips": {
              "type": "integer",
              "minimum": 2,
              "maximum": 4096
            },
            "spacing": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 5
            }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "layerEfficiency",
            "deadLiveFraction",
            "angularResolutionDeg",
            "systematicFraction",
            "angularModel"
          ],
          "properties": {
            "layerEfficiency": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 1
            },
            "deadLiveFraction": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 1
            },
            "angularResolutionDeg": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 20
            },
            "systematicFraction": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "angularModel": {
              "enum": [
                "gaisser",
                "cos2"
              ]
            }
          }
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "position",
        "frame",
        "candidateId",
        "note"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/siteId"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "frame": {
          "const": "model_frame"
        },
        "candidateId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          ]
        },
        "note": {
          "$ref": "#/$defs/note"
        }
      }
    },
    "placement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "site"
          ],
          "properties": {
            "kind": {
              "const": "site"
            },
            "site": {
              "$ref": "#/$defs/siteId"
            }
          }
        }
      ]
    },
    "exposure": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "days"
          ],
          "properties": {
            "kind": {
              "const": "constant"
            },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650
            }
          }
        }
      ]
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "placement",
        "pose",
        "detector",
        "note"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stationId"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "pose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "azimuthDeg",
            "elevationDeg"
          ],
          "properties": {
            "azimuthDeg": {
              "type": "number",
              "minimum": 0,
              "maximum": 359
            },
            "elevationDeg": {
              "type": "number",
              "minimum": 0,
              "maximum": 90
            }
          }
        },
        "detector": {
          "$ref": "#/$defs/detectorId"
        },
        "note": {
          "$ref": "#/$defs/note"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "stations",
        "note"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/deploymentId"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "stations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stationId"
          }
        },
        "note": {
          "$ref": "#/$defs/note"
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "scenario",
        "anomalies"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "label": {
          "type": "string",
          "maxLength": 100
        },
        "scenario": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          ]
        },
        "anomalies": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "scenes",
        "deployments",
        "exposure",
        "aim",
        "basis",
        "note"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/studyId"
        },
        "title": {
          "$ref": "#/$defs/name"
        },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scene"
          }
        },
        "deployments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/deploymentId"
          }
        },
        "exposure": {
          "$ref": "#/$defs/exposure"
        },
        "aim": {
          "type": "null"
        },
        "basis": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "recordedAt",
                "items"
              ],
              "properties": {
                "recordedAt": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
                },
                "items": {
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": {
                    "$ref": "#/$defs/itemId"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            }
          ]
        },
        "note": {
          "$ref": "#/$defs/note"
        }
      }
    }
  }
}
